# .env.example — copy to .env and fill in values
# NEVER commit .env to git

# Required: get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override model (default: gemini-1.5-flash)
# gemini-1.5-flash-8b is faster/cheaper but slightly lower quality
GEMINI_MODEL=gemini-1.5-flash

# Catalog location (relative to project root when running locally)
CATALOG_PATH=data/catalog.json
